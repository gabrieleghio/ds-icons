{
  "name": "@gabrieleghio/icons",
  "private": true,
  "scripts": {
    "import:figma": "tsx scripts/import-figma-icons.ts",
    "generate": "pnpm exec tsx scripts/generate-react.ts && pnpm exec tsx scripts/generate-lit.ts && pnpm exec tsx scripts/generate-static-svg.ts && pnpm exec tsx scripts/generate-index.ts && pnpm exec tsx scripts/generate-core-exports.ts",
    "generate:react": "tsx scripts/generate-react.ts",
    "generate:lit": "tsx scripts/generate-lit.ts",
    "generate:svg": "tsx scripts/generate-static-svg.ts",
    "generate:index": "tsx scripts/generate-index.ts",
    "generate:core-exports": "tsx scripts/generate-core-exports.ts",
    "build": "pnpm run generate && pnpm -r run build",
    "build:react": "pnpm --filter @gabrieleghio/icons-react run build",
    "build:lit": "pnpm --filter @gabrieleghio/icons-lit run build",
    "dev": "pnpm -r run dev",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "devDependencies": {
    "@rollup/plugin-node-resolve": "^15.0.0",
    "@rollup/plugin-typescript": "^11.0.0",
    "@svgr/core": "^8.1.0",
    "@svgr/plugin-jsx": "^8.1.0",
    "@svgr/plugin-svgo": "^8.1.0",
    "@types/node": "^25.5.2",
    "rollup": "^4.0.0",
    "svgo": "^4.0.1",
    "tslib": "^2.6.0",
    "tsx": "^4.21.0",
    "typescript": "^5.0.0",
    "vitest": "^1.0.0",
    "@vitest/coverage-v8": "^1.0.0"
  }
}
